{
  "name": "claude-selection-reference",
  "displayName": "%incipit.displayName%",
  "description": "%incipit.description%",
  "version": "0.0.1",
  "publisher": "incipit",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:incipitClaudeReference.referenceSelection",
    "onCommand:incipitClaudeReference.referenceActiveSelection",
    "onCommand:incipitClaudeReference.referenceActiveFile"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "incipitClaudeReference.referenceSelection",
        "title": "%incipit.command.referenceSelection.title%",
        "icon": "$(references)"
      },
      {
        "command": "incipitClaudeReference.referenceActiveSelection",
        "title": "%incipit.command.referenceActiveSelection.title%",
        "icon": "$(references)"
      },
      {
        "command": "incipitClaudeReference.referenceActiveFile",
        "title": "%incipit.command.referenceActiveFile.title%",
        "icon": "$(file-code)"
      }
    ],
    "configuration": {
      "title": "%incipit.configuration.title%",
      "properties": {
        "incipitClaudeReference.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%incipit.configuration.enabled.description%"
        }
      }
    }
  }
}
